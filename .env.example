# Copy this file to .env. Never commit .env or database files.
# For local demo without external credentials, change EMAIL_MODE to capture.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/haru.db

# capture: save email contents in the authenticated notification inbox;
#          no real email is sent.
# brevo: send real transactional emails through Brevo (requires API key + sender).
# The mode must be explicitly set; missing/invalid values do not fall back to capture.
EMAIL_MODE=brevo
BREVO_API_KEY=
# A single email address registered as a sender in Brevo (no display-name wrapper).
EMAIL_FROM=
EMAIL_FROM_NAME=하루영양

# Set a random secret before starting the reminder worker.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Enable only behind a trusted reverse proxy that overwrites client IP headers.
# Otherwise limits use a shared local bucket instead of trusting spoofable headers.
TRUST_PROXY=false

# The MVP uses Asia/Seoul for all schedule dates and times.
# Timezone is fixed in application logic; changing TZ does not change schedules.
TZ=Asia/Seoul
